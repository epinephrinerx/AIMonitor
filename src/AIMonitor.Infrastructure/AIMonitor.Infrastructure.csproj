<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AIMonitor.Application\AIMonitor.Application.csproj" />
    <ProjectReference Include="..\AIMonitor.Domain\AIMonitor.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets tests inject a controlled/growing stream opener to exercise the credential file

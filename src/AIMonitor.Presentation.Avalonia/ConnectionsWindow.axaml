<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIMonitor.Presentation.Avalonia.ViewModels"
        x:Class="AIMonitor.Presentation.Avalonia.ConnectionsWindow"
        x:DataType="vm:ConnectionsViewModel"
        Title="Connections"
        Width="620" Height="680"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    </Style>
    <!-- The state chip: a word and a glyph, with colour as the third cue rather than the only one. -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.chip.good">
      <Setter Property="BorderBrush" Value="{StaticResource SeverityNormalBrush}" />
    </Style>
    <Style Selector="Border.chip.good TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SeverityNormalBrush}" />
    </Style>
    <Style Selector="Border.chip.warning">
      <Setter Property="BorderBrush" Value="{StaticResource SeverityHighBrush}" />
    </Style>
    <Style Selector="Border.chip.warning TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SeverityHighBrush}" />
    </Style>
    <Style Selector="Border.chip.serious">
      <Setter Property="BorderBrush" Value="{StaticResource SeverityVeryHighBrush}" />
    </Style>
    <Style Selector="Border.chip.serious TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SeverityVeryHighBrush}" />
    </Style>
    <Style Selector="Border.chip.muted">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True" Margin="18">

    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
      <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                 Opacity="0.75" TextWrapping="Wrap" FontSize="12" />
      <Grid ColumnDefinitions="*,Auto">
        <CheckBox Content="Show this page when the app starts" IsChecked="{Binding ShowAtStartup}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Check all again" Command="{Binding RedetectAllCommand}" />
          <Button Content="Close" Command="{Binding CloseCommand}" IsCancel="True" MinWidth="88" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <ScrollViewer>
      <StackPanel>
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConnectionCardViewModel">
            <Border Classes="card" Margin="0,0,0,12">
              <StackPanel Spacing="8">

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Account}" IsVisible="{Binding HasAccount}" FontSize="12" Opacity="0.85" />
                    <TextBlock Text="{Binding SourceLine}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top"
                          Classes.good="{Binding IsGood}" Classes.warning="{Binding IsWarning}"
                          Classes.serious="{Binding IsSerious}" Classes.muted="{Binding IsMuted}">
                    <TextBlock Text="{Binding StateChip}" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </Grid>

                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleEditCommand}" />
                  <Button Content="Re-detect" Command="{Binding RedetectCommand}"
                          ToolTip.Tip="Check this service again, and only this one" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                  <TextBlock Text="Found on this machine" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding HasFoundLine}" />
                  <TextBlock Text="{Binding FoundLine}" IsVisible="{Binding HasFoundLine}" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AlsoPresent}" IsVisible="{Binding HasAlsoPresent}" FontSize="12" Opacity="0.65"
                             TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{Binding SetupHint}" IsVisible="{Binding ShowSignInHelp}"
                           TextWrapping="Wrap" Opacity="0.75" FontSize="12" />

                <StackPanel Spacing="6" IsVisible="{Binding ShowKeyEditor}">
                  <TextBlock Text="{Binding KeyLabel}" FontSize="12" />
                  <Grid ColumnDefinitions="*,Auto">
                    <!-- PasswordChar: the key is a secret, and this page is often open on a shared screen. -->
                    <TextBox Text="{Binding Key}" PlaceholderText="{Binding KeyFieldPlaceholder}" PasswordChar="•"
                             RevealPassword="{Binding IsKeyRevealed}" />
                    <Button Grid.Column="1" Content="{Binding RevealButtonText}" Command="{Binding ToggleRevealCommand}"
                            Margin="6,0,0,0" />
                  </Grid>
                  <TextBlock Text="{Binding KeyHint}" IsVisible="{Binding HasKeyHint}"
                             TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                  <StackPanel Spacing="6" IsVisible="{Binding HasExtra}">
                    <TextBlock Text="{Binding ExtraLabel}" FontSize="12" />
                    <TextBox Text="{Binding Extra}" PlaceholderText="{Binding ExtraPlaceholder}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Click="OnSaveKey" Classes="accent" />
                    <Button Content="Clear saved key" Click="OnClearKey" IsEnabled="{Binding HasSavedKey}" />
                    <Button Content="Cancel" Command="{Binding ToggleEditCommand}" />
                  </StackPanel>
                </StackPanel>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Agents ccusage found that have no tab of their own, and how each one signs in (R-021). -->
      <Border Classes="card" Margin="0,0,0,12">
        <StackPanel Spacing="8">
          <TextBlock Text="Other agents" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Text="{Binding OtherAgentsStatus}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding OtherAgents}" IsVisible="{Binding HasOtherAgents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OtherAgentRow">
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

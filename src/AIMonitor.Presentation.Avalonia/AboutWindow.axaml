<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIMonitor.Presentation.Avalonia.ViewModels"
        x:Class="AIMonitor.Presentation.Avalonia.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="About AI Usage Monitor"
        Width="620" Height="600"
        WindowStartupLocation="CenterOwner">

  <DockPanel LastChildFill="True" Margin="18">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{Binding CheckButtonText}" Command="{Binding CheckUpdatesCommand}" />
      <Button Content="{Binding ReleaseButtonText}" Command="{Binding OpenReleasesCommand}" />
      <Button Content="Close" Command="{Binding CloseCommand}" IsCancel="True" MinWidth="88" />
    </StackPanel>

    <TabControl SelectedIndex="{Binding SelectedPageIndex}">
      <TabItem Header="About">
        <ScrollViewer>
          <StackPanel Spacing="4" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Edition}" FontSize="20" Opacity="0.6" />
            </StackPanel>
            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" Opacity="0.75" />
            <Button Content="{Binding ProjectUrl}" Command="{Binding OpenProjectCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left"
                    FontSize="12" />
            <TextBlock Text="{Binding UpdateStatus}" IsVisible="{Binding HasUpdateStatus}"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="Checking for updates is a read-only request to GitHub. Only releases made for the Mac (the Mac branch) count."
                       TextWrapping="Wrap" Opacity="0.65" FontSize="12" Margin="0,6,0,0" />
            <TextBlock Text="{Binding LicenseSummary}" TextWrapping="Wrap" Opacity="0.75"
                       FontSize="12" Margin="0,6,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Read me">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding ReadmeText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Licence">
        <ScrollViewer>
          <StackPanel>
            <SelectableTextBlock Text="{Binding LicenseText}" IsVisible="{Binding HasLicenseText}"
                       FontFamily="Menlo, Monaco, monospace" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="The licence file is not beside the app. A build that ships without it does not meet GPL-3.0."
                       TextWrapping="Wrap" FontSize="12">
              <TextBlock.IsVisible>
                <Binding Path="HasLicenseText" Converter="{x:Static BoolConverters.Not}" />
              </TextBlock.IsVisible>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Third-party notices">
        <ScrollViewer>
          <StackPanel>
            <SelectableTextBlock Text="{Binding NoticesText}" IsVisible="{Binding HasNoticesText}"
                       FontFamily="Menlo, Monaco, monospace" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="The notices file is not beside the app."
                       TextWrapping="Wrap" FontSize="12">
              <TextBlock.IsVisible>
                <Binding Path="HasNoticesText" Converter="{x:Static BoolConverters.Not}" />
              </TextBlock.IsVisible>
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Developer">
        <ScrollViewer>
          <StackPanel Spacing="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding DeveloperName}" FontSize="17" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding DeveloperEmail}" Opacity="0.75" FontSize="12" />
            <TextBlock Text="{Binding DeveloperBlurb}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,12,0,0" />
            <TextBlock Text="{Binding AssistantsBlurb}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,8,0,0" />
            <TextBlock Text="{Binding LicenseFooter}" TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

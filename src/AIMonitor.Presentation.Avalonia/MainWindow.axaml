<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIMonitor.Presentation.Avalonia.ViewModels"
        xmlns:controls="using:AIMonitor.Presentation.Avalonia.Controls"
        x:Class="AIMonitor.Presentation.Avalonia.MainWindow"
        x:DataType="vm:DashboardViewModel"
        Title="AI Usage Monitor"
        Width="1120" Height="820"
        MinWidth="720" MinHeight="520">

  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The tab strip is an underline, as on Windows: the Fluent "pivot" sizes its headers for
         touch and towers over a dashboard that is mostly numbers and labels. -->
    <Style Selector="ListBox.tabstrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.tabstrip > ListBoxItem">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.tabstrip > ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabstrip > ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>

    <Style Selector="TextBlock.severity">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.severity.sev-normal">
      <Setter Property="Foreground" Value="{StaticResource SeverityNormalBrush}" />
    </Style>
    <Style Selector="TextBlock.severity.sev-high">
      <Setter Property="Foreground" Value="{StaticResource SeverityHighBrush}" />
    </Style>
    <Style Selector="TextBlock.severity.sev-veryhigh">
      <Setter Property="Foreground" Value="{StaticResource SeverityVeryHighBrush}" />
    </Style>
    <Style Selector="TextBlock.severity.sev-critical">
      <Setter Property="Foreground" Value="{StaticResource SeverityCriticalBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <Border DockPanel.Dock="Top" Padding="16,12,16,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="AI Usage Monitor" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="{Binding Status}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          <Button Content="Connections" Command="{Binding OpenConnectionsCommand}" />
          <Button Content="Settings" Command="{Binding OpenSettingsCommand}" />
          <Button Content="More">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Usage log" Command="{Binding OpenUsageLogCommand}" />
                <MenuItem Header="About AI Usage Monitor" Command="{Binding OpenAboutCommand}" />
                <Separator />
                <MenuItem Header="Appearance">
                  <MenuItem Header="System" Command="{Binding SetThemeCommand}" CommandParameter="system" />
                  <MenuItem Header="Light" Command="{Binding SetThemeCommand}" CommandParameter="light" />
                  <MenuItem Header="Dark" Command="{Binding SetThemeCommand}" CommandParameter="dark" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Quit AI Usage Monitor" Command="{Binding ExitCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Margin="16,8,16,12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <ListBox Classes="tabstrip"
               ItemsSource="{Binding Tabs}"
               SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:ProviderViewModel">
            <TextBlock Text="{Binding TabTitle}" />
          </DataTemplate>
          <DataTemplate DataType="vm:AllAgentsTabViewModel">
            <TextBlock Text="{Binding TabTitle}" />
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="caption" Text="{Binding SelectedProvider.Account}" />
        <TextBlock Grid.Column="1" Classes="caption"
                   IsVisible="{Binding IsRefreshing}" Text="Working…" />
      </Grid>
    </Border>

    <ScrollViewer Margin="16,0,16,0">
      <ContentControl Content="{Binding SelectedTab}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:ProviderViewModel">
            <StackPanel Spacing="12">

              <!-- A failed refresh, said once at the top. -->
              <Border Classes="card" IsVisible="{Binding HasError}" Padding="12,8"
                      BorderBrush="{StaticResource SeverityHighBrush}">
                <TextBlock Text="{Binding ErrorMessage, StringFormat='⚠ {0}'}" TextWrapping="Wrap" />
              </Border>

              <!-- Only while the service has nothing to show. -->
              <Border Classes="card" IsVisible="{Binding ShowSetupHint}" Padding="20">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding SetupTitle}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{Binding SetupHint}" TextWrapping="Wrap" />
                  <Button Content="{Binding Title, StringFormat='Configure {0}…'}"
                          HorizontalAlignment="Left" Padding="14,5"
                          Command="{Binding $parent[Window].((vm:DashboardViewModel)DataContext).OpenConnectionsCommand}" />
                </StackPanel>
              </Border>

              <!-- The Overview, while ccusage has nothing for it yet. -->
              <Border Classes="card" IsVisible="{Binding HasEmptyMessage}" Padding="20">
                <TextBlock Classes="caption" Text="{Binding EmptyMessage}" TextWrapping="Wrap" FontSize="13" />
              </Border>

              <!-- One row of gauge cards per section; every row shares a column count so the
                   cards line up across rows. -->
              <ItemsControl ItemsSource="{Binding MeterSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MeterSection">
                    <StackPanel>
                      <TextBlock Text="{Binding Heading}" IsVisible="{Binding HasHeading}"
                                 Classes="caption" FontSize="13" FontWeight="SemiBold" Margin="2,6,0,6" />
                      <ItemsControl ItemsSource="{Binding Meters}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MeterViewModel">
                            <Border Classes="card" Margin="0,0,12,12">
                              <StackPanel>
                                <controls:GaugeControl Height="190"
                                                       Value="{Binding PercentOrZero}"
                                                       ValueText="{Binding ValueText}"
                                                       HasValue="{Binding HasPercent}"
                                                       Title="{Binding GaugeTitle}"
                                                       Subtitle="{Binding Subtitle}"
                                                       Severity="{Binding Severity}" />
                                <TextBlock Classes="severity"
                                           Classes.sev-normal="{Binding IsNormal}"
                                           Classes.sev-high="{Binding IsHigh}"
                                           Classes.sev-veryhigh="{Binding IsVeryHigh}"
                                           Classes.sev-critical="{Binding IsCritical}"
                                           Text="{Binding SeverityText}" Margin="0,4,0,0" />
                                <TextBlock Classes="caption" Text="{Binding ResetText}" FontSize="11"
                                           Margin="0,2,0,0" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Classes="caption" Text="{Binding Detail}" FontSize="11"
                                           IsVisible="{Binding HasDetail}" Margin="0,2,0,0"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Plain readouts that have no window of their own. -->
              <Border Classes="card" IsVisible="{Binding HasStats}" Padding="16,12">
                <ItemsControl ItemsSource="{Binding StatTiles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatTile">
                      <StackPanel Margin="0,0,16,0">
                        <TextBlock Classes="caption" Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Detail}" FontSize="11"
                                   IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <!-- What ccusage recorded for this agent. -->
              <Border Classes="card" IsVisible="{Binding HasAgentUsage}" Padding="16,10">
                <ItemsControl ItemsSource="{Binding AgentUsageRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentUsageRow">
                      <Grid ColumnDefinitions="180,*" Margin="0,2">
                        <TextBlock Classes="caption" Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <!-- A history failure belongs where the charts would be, not in the banner above:
                   it must never look as though the live quota failed too. -->
              <TextBlock Classes="caption" Text="{Binding HistoryNote}"
                         IsVisible="{Binding HasHistoryNote}" TextWrapping="Wrap" Margin="2,0" />

              <!-- Usage per day, stacked by model. -->
              <Border Classes="card" IsVisible="{Binding HasHistory}" Padding="18,14">
                <StackPanel>
                  <TextBlock Text="{Binding ChartTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <controls:StackedColumnChartControl Height="260"
                                                      Buckets="{Binding ChartBuckets}"
                                                      Series="{Binding ChartSeries}"
                                                      Metric="{Binding ChartMetric}"
                                                      Costs="{Binding ChartCosts}" />
                </StackPanel>
              </Border>

              <!-- Where those tokens went: by model and by project, side by side. -->
              <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasHistory}">
                <Border Classes="card" Padding="18,14" Margin="0,0,6,0" VerticalAlignment="Top"
                        IsVisible="{Binding HasModelRows}">
                  <StackPanel>
                    <TextBlock Text="{Binding ModelTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <controls:HorizontalBarChartControl Rows="{Binding ModelRows}"
                                                        Metric="{Binding ChartMetric}"
                                                        Coloured="True" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Padding="18,14" Margin="6,0,0,0" VerticalAlignment="Top"
                        IsVisible="{Binding HasProjectRows}">
                  <StackPanel>
                    <TextBlock Text="{Binding ProjectTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <controls:HorizontalBarChartControl Rows="{Binding ProjectRows}"
                                                        Metric="{Binding ChartMetric}" />
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock Classes="caption" Text="{Binding ValueNote}"
                         IsVisible="{Binding HasValueNote}" TextWrapping="Wrap" Margin="2,0,2,12" />

            </StackPanel>
          </DataTemplate>

          <!-- Every agent ccusage found, as on Windows: today, this month, by day, by month, and the
               latest sessions. -->
          <DataTemplate DataType="vm:AllAgentsTabViewModel">
            <StackPanel Spacing="12" Margin="0,0,0,16">
              <Border Classes="card" IsVisible="{Binding ShowInstallHint}" Padding="20">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
              </Border>

              <StackPanel Spacing="12" IsVisible="{Binding ShowContent}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PricingText}"
                             ToolTip.Tip="{Binding PricingToolTip}" />
                </Grid>

                <Border Classes="card" IsVisible="{Binding ShowError}" Padding="12,8"
                        BorderBrush="{StaticResource SeverityHighBrush}">
                  <TextBlock Text="{Binding ErrorText, StringFormat='⚠ {0}'}" TextWrapping="Wrap" />
                </Border>

                <Grid ColumnDefinitions="*,*">
                  <Border Classes="card" Margin="0,0,6,0" Padding="16,12"
                          IsVisible="{Binding Today, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="Today" />
                      <ContentControl Content="{Binding Today}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="card" Margin="6,0,0,0" Padding="16,12"
                          IsVisible="{Binding ThisMonth, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="caption" Text="This month" />
                      <ContentControl Content="{Binding ThisMonth}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <TextBlock Text="Daily" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding HasDays}" />
                <ItemsControl ItemsSource="{Binding Days}" IsVisible="{Binding HasDays}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentUsagePeriod">
                      <Border Classes="card" Margin="0,0,0,8" Padding="16,10">
                        <ContentControl Content="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Monthly" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding HasMonths}" />
                <ItemsControl ItemsSource="{Binding Months}" IsVisible="{Binding HasMonths}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentUsagePeriod">
                      <Border Classes="card" Margin="0,0,0,8" Padding="16,10">
                        <ContentControl Content="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Recent sessions" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding HasSessions}" />
                <Border Classes="card" Padding="16,10" IsVisible="{Binding HasSessions}">
                  <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AgentUsageSessionLine">
                        <Grid ColumnDefinitions="140,90,140,*,Auto" Margin="0,3">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ShortId}" FontFamily="Menlo" />
                          <TextBlock Grid.Column="2" Classes="caption" Text="{Binding LastActivityText}" />
                          <TextBlock Grid.Column="3" Text="{Binding TokensText}" HorizontalAlignment="Right" Margin="0,0,16,0" />
                          <TextBlock Grid.Column="4" Text="{Binding CostText}" MinWidth="110" TextAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </StackPanel>
          </DataTemplate>

          <!-- One period: its total, then one line per agent. -->
          <DataTemplate DataType="vm:AgentUsagePeriod">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold">
                  <Run Text="{Binding TokensText}" />
                  <Run Text=" · " />
                  <Run Text="{Binding CostText}" />
                </TextBlock>
              </Grid>
              <ItemsControl ItemsSource="{Binding Agents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgentUsageLine">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,1,0,1">
                      <TextBlock Classes="caption" Text="{Binding DisplayName}" FontSize="13" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding TokensText}" FontSize="13" Margin="0,0,16,0" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding CostText}" FontSize="13" MinWidth="110" TextAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </ScrollViewer>

  </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIMonitor.Presentation.Avalonia.ViewModels"
        xmlns:controls="using:AIMonitor.Presentation.Avalonia.Controls"
        x:Class="AIMonitor.Presentation.Avalonia.WidgetWindow"
        x:DataType="vm:WidgetViewModel"
        Title="AI Usage Monitor widget"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="True"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding Opacity}"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="230" Height="175"
        MinWidth="150" MinHeight="96"
        MaxWidth="300" MaxHeight="300">

  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.page">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.lead.sev-high">
      <Setter Property="Foreground" Value="{StaticResource SeverityHighBrush}" />
    </Style>
    <Style Selector="TextBlock.lead.sev-veryhigh">
      <Setter Property="Foreground" Value="{StaticResource SeverityVeryHighBrush}" />
    </Style>
    <Style Selector="TextBlock.lead.sev-critical">
      <Setter Property="Foreground" Value="{StaticResource SeverityCriticalBrush}" />
    </Style>
    <Style Selector="TextBlock.lead.sev-normal">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </Window.Styles>

  <!-- The whole card is the drag handle: a frameless window has no title bar to grab. The menu is
       built when it opens (code-behind), so its check marks always match what is on show. -->
  <Border Name="Root"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="11"
          PointerPressed="OnPointerPressed"
          DoubleTapped="OnDoubleTapped">

    <DockPanel LastChildFill="True">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,5">
        <Button Classes="page" Content="&#x2039;" Command="{Binding PreviousCommand}"
                IsVisible="{Binding CanPage}" ToolTip.Tip="Previous service" />
        <TextBlock Grid.Column="1" Name="HeaderText" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Button Grid.Column="2" Classes="page" Content="&#x203A;" Command="{Binding NextCommand}"
                IsVisible="{Binding CanPage}" ToolTip.Tip="Next service" />
      </Grid>

      <TextBlock DockPanel.Dock="Bottom" Classes="caption" Text="{Binding StatusText}"
                 IsVisible="{Binding ShowFooter}" HorizontalAlignment="Center" Margin="0,4,0,0" />

      <Panel>
        <TextBlock Classes="caption" Text="Too small to show the meters."
                   IsVisible="{Binding IsTooSmall}" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

        <TextBlock Classes="caption" Text="{Binding EmptyMessage}" IsVisible="{Binding HasEmptyMessage}" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

        <StackPanel IsVisible="{Binding HasMeters}" VerticalAlignment="Top">
          <!-- The same dials as the dashboard, shrunk; how many fit is decided by the width. -->
          <ItemsControl Name="Gauges" ItemsSource="{Binding VisibleMeters}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MeterViewModel">
                <StackPanel Width="{Binding $parent[ItemsControl].((vm:WidgetViewModel)DataContext).Cell}"
                            ToolTip.Tip="{Binding ResetText}">
                  <controls:GaugeControl HorizontalAlignment="Center"
                                         Width="{Binding $parent[ItemsControl].((vm:WidgetViewModel)DataContext).ArcSize}"
                                         Height="{Binding $parent[ItemsControl].((vm:WidgetViewModel)DataContext).ArcSize}"
                                         Value="{Binding PercentOrZero}"
                                         ValueText="{Binding ValueText}"
                                         HasValue="{Binding HasPercent}"
                                         Severity="{Binding Severity}" />
                  <TextBlock Text="{Binding GaugeTitle}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"
                             HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding Subtitle}" HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding $parent[ItemsControl].((vm:WidgetViewModel)DataContext).ShowSubtitle}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="lead" Text="{Binding LeadHeadText}" IsVisible="{Binding ShowLeadHead}" FontSize="10"
                     Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Classes.sev-normal="{Binding IsLeadNormal}" Classes.sev-high="{Binding IsLeadHigh}"
                     Classes.sev-veryhigh="{Binding IsLeadVeryHigh}" Classes.sev-critical="{Binding IsLeadCritical}" />
          <TextBlock Classes="caption" Text="{Binding ResetLineText}" IsVisible="{Binding ShowResetLine}"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Panel>

    </DockPanel>
  </Border>
</Window>

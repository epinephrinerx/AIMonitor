<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIMonitor.Presentation.Avalonia.ViewModels"
        x:Class="AIMonitor.Presentation.Avalonia.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner">

  <DockPanel LastChildFill="True" Margin="18">

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}"
               Foreground="{StaticResource SeverityCriticalBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,16,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" />
      <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="88"
              Classes="accent" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="18">

        <StackPanel Spacing="8">
          <TextBlock Text="Appearance" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" MinWidth="220"
                    HorizontalAlignment="Left" />
          <TextBlock Text="&quot;Follow macOS&quot; changes with the macOS appearance setting as it changes."
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Default window size" Margin="0,6,0,0" />
          <ComboBox ItemsSource="{Binding WindowSizeOptions}" SelectedItem="{Binding SelectedWindowSize}" MinWidth="260"
                    HorizontalAlignment="Left" />
          <TextBlock Text="A size you pick here is applied to the window straight away. &quot;Remember last size&quot; keeps whatever you dragged it to."
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Starting and staying open" FontWeight="SemiBold" />
          <CheckBox Content="Open at login" IsChecked="{Binding StartAtLogin}" />
          <CheckBox Content="Show an item in the menu bar" IsChecked="{Binding ShowMenuBarExtra}" />
          <CheckBox Content="Closing the window leaves the app in the menu bar"
                    IsChecked="{Binding MinimizeToMenuBar}"
                    IsEnabled="{Binding ShowMenuBarExtra}" />
          <TextBlock Text="Without a menu bar item there would be no way to bring the app back, so that option needs this one."
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Refreshing" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding RefreshIntervalText}" Width="100" />
            <TextBlock Text="seconds · 0 means only when asked" VerticalAlignment="Center"
                       Opacity="0.65" FontSize="12" />
          </StackPanel>
          <TextBlock Text="{Binding RefreshIntervalError}" IsVisible="{Binding HasIntervalError}"
                     Foreground="{StaticResource SeverityCriticalBrush}" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Services to monitor" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProviderToggle">
                <StackPanel Margin="0,0,0,6">
                  <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Enabled}" />
                  <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}" Margin="28,0,0,0"
                             Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Monthly budgets" FontWeight="SemiBold" />
          <TextBlock Text="In US dollars. The OpenCode and Overview gauges measure this month's ccusage cost against these. Leave a box empty for no budget."
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding BudgetRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentBudgetRowViewModel">
                <StackPanel Margin="0,2">
                  <Grid ColumnDefinitions="160,140">
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Text}" PlaceholderText="No budget" />
                  </Grid>
                  <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                             Foreground="{StaticResource SeverityCriticalBrush}" FontSize="12" Margin="160,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Widget mode" FontWeight="SemiBold" />
          <TextBlock Text="Press ⇧⌘W or use the Widget button to collapse into the compact widget. Double-click the widget to expand it again."
                     Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
          <CheckBox Content="Keep the widget above other windows" IsChecked="{Binding WidgetAlwaysOnTop}" />
          <CheckBox Content="Let the widget take turns between services" IsChecked="{Binding WidgetRotationEnabled}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Opacity" VerticalAlignment="Center" />
            <Slider Minimum="0.25" Maximum="1" TickFrequency="0.05" Value="{Binding WidgetOpacity}" Width="200" />
            <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0}%}" VerticalAlignment="Center"
                       MinWidth="44" />
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

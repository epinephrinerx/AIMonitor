<Window x:Class="AIMonitor.Presentation.Wpf.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor — Version"
        Width="480" Height="300"
        MinWidth="460" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24,22,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Version: the installed version and an on-demand check against GitHub releases -->
        <StackPanel x:Name="VersionPanel" Grid.Row="0">
            <TextBlock Text="AI Usage Monitor" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
            <TextBlock Margin="0,10,0,0" FontSize="12">
                <Hyperlink x:Name="ProjectLink" Command="{Binding OpenProjectUrlCommand}">
                    <Run Text="{Binding ProjectUrl, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="UpdateStatusText" Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="CheckButton" Content="{Binding CheckButtonText}" Command="{Binding CheckUpdatesCommand}"
                        Padding="14,5" Margin="0,0,8,0" Cursor="Hand" />
                <Button x:Name="ReleasesButton" Content="{Binding ReleaseButtonText}" Command="{Binding OpenReleaseUrlCommand}"
                        Padding="14,5" Cursor="Hand" />
            </StackPanel>
        </StackPanel>

        <!-- Developer: who wrote this, and under what licence it is given to you -->
        <StackPanel x:Name="DeveloperPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="{Binding DeveloperName}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap">
                <Hyperlink NavigateUri="{Binding DeveloperEmail, StringFormat='mailto:{0}'}" RequestNavigate="OnNavigate">
                    <Run Text="{Binding DeveloperEmail, Mode=OneWay}" />
                </Hyperlink>
                <Run Text="  ·  " Foreground="{DynamicResource TextSecondaryBrush}" />
                <Hyperlink Command="{Binding OpenProjectUrlCommand}">
                    <Run Text="github.com/epinephrinerx/AIMonitor" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Text="{Binding DeveloperBlurb}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0" />
            <TextBlock Text="{Binding AssistantsBlurb}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding LicenseFooter}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Readme / License / Third-party notices: one read-only reader -->
        <Border x:Name="DocumentPanel" Grid.Row="0" Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12">
            <TextBox x:Name="DocumentText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="12"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <Button Grid.Row="1" x:Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" Padding="18,6" Margin="0,12,0,0" Cursor="Hand" />
    </Grid>
</Window>

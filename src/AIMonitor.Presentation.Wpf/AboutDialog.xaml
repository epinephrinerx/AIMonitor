<Window x:Class="AIMonitor.Presentation.Wpf.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AIMonitor 2.0"
        Width="580" Height="480"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0">
            <!-- Overview Tab -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,16,12,12">
                        <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,16" />

                        <!-- Update Check Banner -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Update Status:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Content="Download Latest Release" Command="{Binding OpenReleaseUrlCommand}"
                                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Developer & Project Info -->
                        <TextBlock Text="Developer:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding DeveloperName}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="Email:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding DeveloperEmail}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <TextBlock Text="Repository:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                        <Button Content="{Binding ProjectUrl}" Command="{Binding OpenProjectUrlCommand}"
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Readme Tab -->
            <TabItem Header="Information">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,12,4,4">
                    <TextBox Text="{Binding ReadmeText, Mode=OneTime}" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="12" />
                </Border>
            </TabItem>

            <!-- License Tab -->
            <TabItem Header="License (GPL-3.0)">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,12,4,4">
                    <TextBox Text="{Binding LicenseText, Mode=OneTime}" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontFamily="Consolas, monospace" FontSize="11"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" Padding="18,6" Cursor="Hand" />
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="AIMonitor.Presentation.Wpf.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AIMonitor.Presentation.Wpf.Controls"
        xmlns:vm="clr-namespace:AIMonitor.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="AIMonitor Widget"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding Opacity}"
        MinWidth="150" MinHeight="96" MaxWidth="300" MaxHeight="300"
        Width="230" Height="175"
        MouseDown="OnWindowMouseDown"
        ToolTip="Drag to move · drag an edge to resize · double-click to expand · right-click for options">
    <!-- Per-pixel-alpha layered windows pass clicks through alpha-0 pixels, so the rounded-corner slivers inside the 7px resize band would not resize; alpha 1 keeps them hit-testable and is visually invisible. -->
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Margin="0">

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRowDefinition" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRowDefinition" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header: service name left, chevrons right (only when there is somewhere to go) -->
            <DockPanel Grid.Row="0" VerticalAlignment="Top" Height="{Binding HeaderHeight}" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding CanPage, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="&#x2039;" Command="{Binding PreviousProviderCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                            FontSize="16" FontWeight="Bold" Cursor="Hand" Padding="5,0" ToolTip="Previous service" />
                    <Button Content="&#x203A;" Command="{Binding NextProviderCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                            FontSize="16" FontWeight="Bold" Cursor="Hand" Padding="5,0" ToolTip="Next service" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentProvider.DisplayName}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Center Gauge Display / Too Small Message -->
            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock x:Name="EmptyMessageTextBlock"
                           Text="{Binding EmptyMessage}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMeters}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock x:Name="TooSmallTextBlock"
                           Text="Too small to show the meters."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTooSmall}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel VerticalAlignment="Top">
                <ItemsControl x:Name="MetersItemsControl"
                              ItemsSource="{Binding VisibleMeters}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTooSmall}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,-6,0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GaugeControl Value="{Binding Value}"
                                                   ValueText="{Binding ValueText}"
                                                   Title="{Binding Title}"
                                                   Subtitle="{Binding Subtitle}"
                                                   Severity="{Binding Severity}"
                                                   Width="{Binding DataContext.Cell, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   CaptionLines="{Binding DataContext.CaptionLines, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   ArcSize="{Binding DataContext.ArcSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   CaptionLineHeight="{Binding DataContext.LineHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   ShowSubtitle="{Binding DataContext.ShowSubtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   ShowInlineValue="{Binding DataContext.InlineValue, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    <TextBlock x:Name="LeadHeadTextBlock" Text="{Binding LeadHeadText}" FontSize="10" Margin="0,4,0,0"
                               Foreground="{Binding LeadHeadBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowLeadHead, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="ResetLineTextBlock" Text="{Binding ResetLineText}" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowResetLine, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <!-- Footer: Status -->
            <TextBlock x:Name="FooterTextBlock" Grid.Row="2" Text="{Binding StatusText}" FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVisibility}}"
                       VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>

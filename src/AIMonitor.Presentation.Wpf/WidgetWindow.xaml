<Window x:Class="AIMonitor.Presentation.Wpf.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AIMonitor.Presentation.Wpf.Controls"
        xmlns:vm="clr-namespace:AIMonitor.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="AIMonitor Widget"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding Opacity}"
        MinWidth="150" MinHeight="96" MaxWidth="300" MaxHeight="300"
        Width="230" Height="175"
        MouseDown="OnWindowMouseDown">
    <!-- Per-pixel-alpha layered windows pass clicks through alpha-0 pixels, so the rounded-corner slivers inside the 7px resize band would not resize; alpha 1 keeps them hit-testable and is visually invisible. -->
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Margin="0">

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRowDefinition" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRowDefinition" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header with Chevrons and Title -->
            <DockPanel Grid.Row="0" VerticalAlignment="Top" Height="{Binding HeaderHeight}">
                <Button Content="&#x25C0;" Command="{Binding PreviousProviderCommand}" DockPanel.Dock="Left"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="11" Cursor="Hand" Padding="4,0" ToolTip="Previous provider" />
                
                <Button Content="&#x25B6;" Command="{Binding NextProviderCommand}" DockPanel.Dock="Right"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="11" Cursor="Hand" Padding="4,0" ToolTip="Next provider" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentProvider.DisplayName}" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <Button Content="&#x1F4CC;" Command="{Binding TogglePinCommand}" Margin="6,0,0,0"
                            Background="Transparent" BorderThickness="0" FontSize="10" Cursor="Hand"
                            Opacity="{Binding IsPinned, Converter={x:Null}}" ToolTip="Toggle rotation pin" />
                </StackPanel>
            </DockPanel>

            <!-- Center Gauge Display / Too Small Message -->
            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock x:Name="TooSmallTextBlock"
                           Text="Too small to show the meters."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTooSmall}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl x:Name="MetersItemsControl"
                              ItemsSource="{Binding VisibleMeters}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTooSmall}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,-6,0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,6,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GaugeControl Value="{Binding Value}"
                                                   ValueText="{Binding ValueText}"
                                                   Title="{Binding Title}"
                                                   Subtitle="{Binding Subtitle}"
                                                   Severity="{Binding Severity}"
                                                   Width="{Binding DataContext.Cell, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   CaptionLines="{Binding DataContext.CaptionLines, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   ArcSize="{Binding DataContext.ArcSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   CaptionLineHeight="{Binding DataContext.LineHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   ShowSubtitle="{Binding DataContext.ShowSubtitle, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   ShowInlineValue="{Binding DataContext.InlineValue, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Footer: Status -->
            <TextBlock Grid.Row="2" Text="{Binding CurrentProvider.Status}" FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>

<Window x:Class="AIMonitor.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AIMonitor.Presentation.Wpf.Controls"
        xmlns:vm="clr-namespace:AIMonitor.Presentation.Wpf.ViewModels"
        xmlns:local="clr-namespace:AIMonitor.Presentation.Wpf"
        mc:Ignorable="d"
        Title="AIMonitor 2.0"
        MinWidth="300" MinHeight="220"
        Width="1020" Height="720"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenAboutCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding OpenLogCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding OpenLogCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding SwitchToWidgetCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    
    <DockPanel>
    <Menu DockPanel.Dock="Top" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}">
        <MenuItem Header="_File">
            <MenuItem Header="_Refresh" InputGestureText="F5" Command="{Binding RefreshCommand}" />
            <MenuItem Header="Sign-in / _Connections…" Command="{Binding ShowConnectionsCommand}" />
            <Separator />
            <MenuItem Header="Save to _Log…" InputGestureText="Ctrl+L" Command="{Binding OpenLogCommand}" />
            <MenuItem Header="_Print Report…" InputGestureText="Ctrl+P" Command="{Binding OpenLogCommand}" />
            <Separator />
            <MenuItem Header="E_xit" InputGestureText="Ctrl+Q" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="_Settings">
            <MenuItem Header="_Themes">
                <MenuItem Header="Follow Windows" IsCheckable="True" IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="system" />
                <MenuItem Header="Light" IsCheckable="True" IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="light" />
                <MenuItem Header="Dark" IsCheckable="True" IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="dark" />
            </MenuItem>
            <MenuItem Header="_Widget mode" InputGestureText="Ctrl+W" Command="{Binding SwitchToWidgetCommand}" />
            <Separator />
            <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
        </MenuItem>
        <MenuItem Header="_About">
            <MenuItem Header="Check for _updates…" Command="{Binding CheckForUpdatesCommand}" />
            <MenuItem Header="_Version…" Command="{Binding ShowAboutCommand}" CommandParameter="Version" />
            <MenuItem Header="_Readme" InputGestureText="F1" Command="{Binding ShowAboutCommand}" CommandParameter="Readme" />
            <MenuItem Header="_License Agreement" Command="{Binding ShowAboutCommand}" CommandParameter="License" />
            <MenuItem Header="Third-party _notices" Command="{Binding ShowAboutCommand}" CommandParameter="Notices" />
            <Separator />
            <MenuItem Header="About the _developer" Command="{Binding ShowAboutCommand}" CommandParameter="Developer" />
        </MenuItem>
    </Menu>
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Provider Navigation -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="AIMonitor" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="2.0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="6,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="AccountLabelText" Text="{Binding SelectedTab.AccountLabel}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="MetricCombo" ItemsSource="{Binding MetricOptions}" SelectedItem="{Binding SelectedMetric}"
                          DisplayMemberPath="Label" MinWidth="120" Margin="0,0,8,0" />
                <ComboBox x:Name="RangeCombo" ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}"
                          DisplayMemberPath="Label" MinWidth="90" Margin="0,0,8,0" />
                <ComboBox x:Name="IntervalCombo" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedInterval}"
                          DisplayMemberPath="Label" MinWidth="170" Margin="0,0,8,0" />
                <Button Content="Widget" Command="{Binding SwitchToWidgetCommand}" ToolTip="Collapse to the desk widget (Ctrl+W)"
                        Padding="14,5" Margin="0,0,8,0" Cursor="Hand" />
                <Button x:Name="RefreshButton" Command="{Binding RefreshCommand}" Padding="14,5" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Refresh" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <Setter Property="Content" Value="Refreshing…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Provider Tab Bar -->
        <Border x:Name="ProviderTabBar" Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnectionsPageVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ListBox ItemsSource="{Binding ProviderTabs}" SelectedItem="{Binding SelectedTab}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Underline" Padding="14,8" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TabTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Selected Provider Content -->
        <ScrollViewer x:Name="ProviderContentScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnectionsPageVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0,0,0,16">
                <!-- Error banner -->
                <Border x:Name="ErrorBanner" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SeverityWarningBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SelectedTab.ErrorMessage, StringFormat=⚠ {0}}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>

                <!-- Setup card (service not configured) -->
                <Border x:Name="SetupCard" CornerRadius="10" Padding="20" Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.ShowSetupCard}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTab.SetupTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedTab.SetupHint}" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="{Binding SelectedTab.DisplayName}" ContentStringFormat="Configure {0}…"
                                Command="{Binding ShowConnectionsCommand}" HorizontalAlignment="Left" Padding="14,5" Cursor="Hand" />
                    </StackPanel>
                </Border>

                <!-- Gauges row: equal-width cards, one row -->
                <ItemsControl x:Name="GaugeRow" ItemsSource="{Binding SelectedTab.Meters}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <controls:GaugeControl Value="{Binding Value}" ValueText="{Binding ValueText}"
                                                           Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                                                           Severity="{Binding Severity}" Height="190" />
                                    <TextBlock Text="{Binding SeverityText}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{Binding GaugeBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding ResetText}" HorizontalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Stat tiles -->
                <Border x:Name="StatsRow" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.StatTiles.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ItemsControl ItemsSource="{Binding SelectedTab.StatTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- History problem: reported where the charts would be, not in the top banner -->
                <TextBlock x:Name="HistoryNote" Text="{Binding SelectedTab.HistoryNote}" TextWrapping="Wrap" Margin="2,0,2,12"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.HasHistoryNote}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Usage per day (stacked by model) -->
                <Border x:Name="DailyChartCard" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.HasHistory}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTab.ChartTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <controls:StackedColumnChartControl Buckets="{Binding SelectedTab.ChartBuckets}"
                                                            Series="{Binding SelectedTab.ChartSeries}"
                                                            Metric="{Binding SelectedTab.ChartMetric}"
                                                            Height="260" />
                    </StackPanel>
                </Border>

                <!-- By model / By project -->
                <UniformGrid x:Name="BreakdownRow" Rows="1" Margin="0,0,0,12">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.HasHistory}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <Border x:Name="ModelCard" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,6,0" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.HasModelRows}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTab.ModelTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <controls:HorizontalBarChartControl Rows="{Binding SelectedTab.ModelRows}"
                                                                Metric="{Binding SelectedTab.ChartMetric}" Coloured="True" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ProjectCard" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="6,0,0,0" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.HasProjectRows}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTab.ProjectTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <controls:HorizontalBarChartControl Rows="{Binding SelectedTab.ProjectRows}"
                                                                Metric="{Binding SelectedTab.ChartMetric}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Provider footnote -->
                <TextBlock x:Name="ValueNote" Text="{Binding SelectedTab.ValueNote}" TextWrapping="Wrap" FontSize="11" Margin="2,0,2,0"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab.HasValueNote}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
 
        <!-- Connections Page Wrapper -->
        <Grid x:Name="ConnectionsWrapper"
              Grid.Row="1"
              Grid.RowSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnectionsPageVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <local:ConnectionsPage x:Name="ConnectionsPageControl"
                                   DataContext="{Binding Connections}" />
        </Grid>

        <!-- Bottom Status Bar -->
        <StatusBar Grid.Row="3" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding LastRefreshStatus}" FontSize="11" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
    </DockPanel>
</Window>

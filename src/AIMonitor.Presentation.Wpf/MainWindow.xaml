<Window x:Class="AIMonitor.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AIMonitor.Presentation.Wpf.Controls"
        xmlns:vm="clr-namespace:AIMonitor.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="AIMonitor 2.0"
        MinWidth="300" MinHeight="220"
        Width="1020" Height="720"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenAboutCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding OpenLogCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding SwitchToWidgetCommand}" />
    </Window.InputBindings>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Provider Navigation -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="AIMonitor" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="2.0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="6,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Compact Widget" Command="{Binding SwitchToWidgetCommand}" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="Usage Log" Command="{Binding OpenLogCommand}" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="About" Command="{Binding OpenAboutCommand}" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="14,6" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </DockPanel>

        <!-- Provider Tab Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,16">
            <ListBox ItemsSource="{Binding ProviderTabs}" SelectedItem="{Binding SelectedTab}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,8" CornerRadius="6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Status}" FontSize="11" Margin="8,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Selected Provider Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,16">
                <!-- Status & Account Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Status: " FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedTab.Status}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding SelectedTab.StatusDetail, StringFormat=' ({0})'}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedTab.AccountInfo}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedTab.StatsSummary}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <!-- Gauges Section -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Quota Usage" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding SelectedTab.Meters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8" Width="160" Height="170" Background="{DynamicResource CardHoverBrush}" CornerRadius="8" Padding="8">
                                        <controls:GaugeControl Value="{Binding Value}"
                                                               ValueText="{Binding ValueText}"
                                                               Title="{Binding Title}"
                                                               Subtitle="{Binding Subtitle}"
                                                               GaugeBrush="{Binding GaugeBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Daily Usage Chart Section -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Daily Usage (Tokens)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                        <controls:DailyChartControl Items="{Binding SelectedTab.DailyUsage}"
                                                    BarBrush="{DynamicResource AccentBrush}"
                                                    Height="180" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <StatusBar Grid.Row="3" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding LastRefreshStatus}" FontSize="11" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

<Window x:Class="AIMonitor.Presentation.Wpf.Updates.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor — Update"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="24,20,24,16">
        <TextBlock x:Name="Heading" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Height="12" Margin="0,14,0,0" />
        <TextBlock x:Name="Percent" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" Text="Starting…" />
        <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" HorizontalAlignment="Right"
                Padding="16,5" Margin="0,14,0,0" Cursor="Hand" Click="OnCancel" />
    </StackPanel>
</Window>

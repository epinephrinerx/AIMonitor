<UserControl x:Class="AIMonitor.Presentation.Wpf.AllAgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AIMonitor.Presentation.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AllAgentsTabViewModel}">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="AgentLineTemplate" DataType="{x:Type vm:AgentUsageLine}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding DisplayName}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TokensText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="12,0,0,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding CostText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PeriodContentTemplate" DataType="{x:Type vm:AgentUsagePeriod}">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TokensText}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text=" · "
                               FontSize="20"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="4,0" />
                    <TextBlock Text="{Binding CostText}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Agents}"
                              ItemTemplate="{StaticResource AgentLineTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PeriodCardTemplate" DataType="{x:Type vm:AgentUsagePeriod}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,0,0,12">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource PeriodContentTemplate}"
                                Focusable="False" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Status line -->
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   ToolTip="{Binding PricingToolTip}"
                   Margin="0,0,0,8" />

        <!-- Error / install hint card -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SeverityWarningBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <!-- Summary cards -->
        <UniformGrid Rows="1" Margin="0,0,0,12">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,0,6,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Today}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Today"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ContentControl Content="{Binding Today}"
                                    ContentTemplate="{StaticResource PeriodContentTemplate}"
                                    Focusable="False" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="6,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ThisMonth}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="This month"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ContentControl Content="{Binding ThisMonth}"
                                    ContentTemplate="{StaticResource PeriodContentTemplate}"
                                    Focusable="False" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Daily -->
        <TextBlock Text="Daily"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource PeriodCardTemplate}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Days.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>

        <!-- Monthly -->
        <TextBlock Text="Monthly"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,8,0,8" />
        <ItemsControl ItemsSource="{Binding Months}" ItemTemplate="{StaticResource PeriodCardTemplate}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Months.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>

        <!-- Recent sessions -->
        <TextBlock Text="Recent sessions"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,8,0,8" />
        <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AgentUsageSessionLine}">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ShortId}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LastActivityText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TokensText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CostText}"
                                       FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

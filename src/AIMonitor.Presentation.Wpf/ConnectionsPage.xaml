<UserControl x:Class="AIMonitor.Presentation.Wpf.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AIMonitor.Presentation.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionsViewModel}"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <!-- Header (Title & Subtitle) -->
            <RowDefinition Height="Auto" />
            <!-- Cards List -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleTextBlock"
                       Text="Your AI services"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />
            <TextBlock x:Name="SubtitleTextBlock"
                       Text="Each service is detected the same way: this app looks for a sign-in you already have - a CLI login, an environment variable, or a key saved here - and never writes to another tool's credentials."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Cards List -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,12">
            <ItemsControl x:Name="CardsItemsControl" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionCardViewModel}">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Round Badge with BadgeLetter -->
                                <Border Grid.Column="0"
                                        x:Name="BadgeBorder"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        Background="{DynamicResource CardHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top"
                                        Margin="0,0,14,0">
                                    <TextBlock x:Name="BadgeLetterText"
                                               Text="{Binding Meta.BadgeLetter}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Card Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="DisplayNameText"
                                                   Text="{Binding Meta.DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- State chip: glyph + word, always visible, colour via DataTriggers on StateWord -->
                                        <Border x:Name="StateChip"
                                                CornerRadius="8"
                                                Padding="8,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    <Setter Property="Background" Value="#14808080" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateWord}" Value="Connected">
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SeverityNormalBrush}" />
                                                            <Setter Property="Background" Value="#2010B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateWord}" Value="Limited">
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SeverityWarningBrush}" />
                                                            <Setter Property="Background" Value="#20F59E0B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateWord}" Value="Expired">
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SeverityCriticalBrush}" />
                                                            <Setter Property="Background" Value="#20EF4444" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="StateGlyphText"
                                                           Text="{Binding StateGlyph}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Margin="0,0,4,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="StateWordText"
                                                           Text="{Binding StateWord}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="AccountText"
                                               Text="{Binding Account}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,2" />
                                    <TextBlock x:Name="SourceLineText"
                                               Text="{Binding SourceLine}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- Buttons: ConnectButtonText (ConnectCommand) and Re-detect (RedetectCommand) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Width="112">
                                    <Button x:Name="ConnectButton"
                                            Content="{Binding ConnectButtonText}"
                                            Command="{Binding ConnectCommand}"
                                            Width="112"
                                            Padding="12,6"
                                            Margin="0,0,0,6"
                                            Cursor="Hand" />
                                    <Button x:Name="RedetectButton"
                                            Content="Re-detect"
                                            Command="{Binding RedetectCommand}"
                                            Width="112"
                                            Padding="12,6"
                                            Cursor="Hand" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <CheckBox x:Name="ShowAtStartupCheckBox"
                      Content="Show this page at startup"
                      IsChecked="{Binding ShowAtStartup, Mode=TwoWay}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Left" />

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="RedetectAllButton"
                        Content="Re-detect all"
                        Command="{Binding RedetectAllCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Cursor="Hand" />
                <Button x:Name="OpenDashboardButton"
                        Content="Open dashboard"
                        Command="{Binding OpenDashboardCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="16,6"
                        Cursor="Hand" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>

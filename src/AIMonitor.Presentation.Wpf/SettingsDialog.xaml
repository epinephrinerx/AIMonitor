<Window x:Class="AIMonitor.Presentation.Wpf.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings — AIMonitor"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <!-- Theme Option -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Appearance Theme" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Theme, Mode=TwoWay}" Padding="6">
                            <ComboBoxItem Content="Follow Windows (System)" Tag="system" />
                            <ComboBoxItem Content="Light Theme" Tag="light" />
                            <ComboBoxItem Content="Dark Theme" Tag="dark" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Windows Integration -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="System Integrations" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Start AIMonitor with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Content="Minimize to System Tray on close" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Content="Show icon in System Tray" IsChecked="{Binding ShowTrayIcon}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Widget Customization -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Compact Widget" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Always on top" IsChecked="{Binding WidgetAlwaysOnTop}" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Widget Opacity:" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WidgetOpacity, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" />
                            <Slider Minimum="0.25" Maximum="1.0" Value="{Binding WidgetOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Polling Interval -->
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Refresh Schedule" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <DockPanel>
                            <TextBlock Text="Check interval (seconds):" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <TextBox Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Right" Padding="4" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,6" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="20,6" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
